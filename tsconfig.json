{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "bun"
    ],
    "lib": [
      "ESNext",
      "DOM"
    ],
    "outDir": "dist"
  },
  "include": [
    "src",
    "scripts"
  ]
}
