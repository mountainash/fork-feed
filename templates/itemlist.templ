package templates

import "github.com/kontrolplane/feed/internal/store"
import "fmt"

templ ItemList(data ListData) {
	<main
		class="list"
		id="main"
		hx-get="/partials/list"
		hx-trigger="every 900s"
		hx-swap="outerHTML"
	>
		<div class="list-head">
			<div class="crumb">
				<span>{ data.Crumb }</span>
				<span>·</span>
				<span>{ fmt.Sprintf("%d items", len(data.Items)) }</span>
			</div>
			<h1>{ data.Title }</h1>
			<div class="meta">
				<button
					class={ templ.KV("on", data.Sort == "newest") }
					hx-get="/partials/list?sort=newest"
					hx-target="#main"
					hx-swap="outerHTML"
				>newest</button>
				<button
					class={ templ.KV("on", data.Sort == "oldest") }
					hx-get="/partials/list?sort=oldest"
					hx-target="#main"
					hx-swap="outerHTML"
				>oldest</button>
				<button
					class={ templ.KV("on", data.Sort == "unread") }
					hx-get="/partials/list?sort=unread"
					hx-target="#main"
					hx-swap="outerHTML"
				>unread first</button>
			</div>
		</div>
		<div class="list-body" id="list-body">
			if len(data.Items) == 0 {
				<div style="padding:40px 20px;opacity:0.5;font-size:12px">
					nothing here. try another view.
				</div>
			}
			for idx, item := range data.Items {
				@ItemRow(item, idx, feedForItem(item, data.Feeds))
			}
		</div>
	</main>
}

func feedForItem(item store.Item, feeds []store.Feed) *store.Feed {
	for _, f := range feeds {
		if f.ID == item.FeedID {
			return &f
		}
	}
	return nil
}

templ ItemRow(item store.Item, idx int, feed *store.Feed) {
	<a
		class={ "item", templ.KV("unread", !item.Read) }
		id={ "item-" + item.ID }
		hx-get={ "/items/" + item.ID }
		hx-target="#reader"
		hx-swap="outerHTML"
	>
		<div class="n">{ Pad2(idx + 1) }</div>
		<div class="main">
			<div class="feed-line">
				if feed != nil {
					<span class="feed-path">{ feed.Title } <span class="sep">/</span> { item.Folder }</span>
				}
				<span class="sep">·</span>
				<span class="tag">{ item.Tag }</span>
			</div>
			<h3>{ item.Title }</h3>
			<div class="authors">{ item.Authors }</div>
			<div class="abs">{ item.Abstract }</div>
		</div>
		<div class="right">
			<button
				class={ "star", templ.KV("on", item.Starred) }
				hx-post={ "/items/" + item.ID + "/star" }
				hx-target={ "#item-" + item.ID }
				hx-swap="outerHTML"
				title="star"
				onClick="event.stopPropagation(); event.preventDefault();"
			>★</button>
			<div>{ FormatDate(item.Date) }</div>
			<div>{ fmt.Sprintf("%dm", item.Minutes) }</div>
		</div>
	</a>
}
