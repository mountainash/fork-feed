package templates

import "github.com/kontrolplane/feed/internal/store"
import "fmt"

templ Sidebar(data SidebarData) {
	<aside class="sidebar" id="sidebar">
		@sidebarInner(data)
	</aside>
}

templ sidebarInner(data SidebarData) {
	<section>
		<h5><span>[ views ]</span></h5>
		@sidebarView("01", "all items", "all", data.Counts.All, data.View)
		@sidebarView("02", "unread", "unread", data.Counts.Unread, data.View)
		@sidebarView("03", "read", "read", data.Counts.Read, data.View)
		@sidebarView("04", "starred", "starred", data.Counts.Starred, data.View)
	</section>
	<section>
		<h5><span>[ timeline ]</span></h5>
		@sidebarView("01", "today", "today", data.Counts.Today, data.View)
		@sidebarView("02", "yesterday", "yesterday", data.Counts.Yesterday, data.View)
		@sidebarView("03", "last week", "last-week", data.Counts.LastWeek, data.View)
		@sidebarView("04", "last month", "last-month", data.Counts.LastMonth, data.View)
	</section>
	<section>
		<h5>
			<span>[ folders ]</span>
			<a
				class="add"
				hx-get="/folders/new"
				hx-target="#modal"
				hx-swap="innerHTML"
				title="add folder"
			>＋</a>
		</h5>
		for i, folder := range data.Folders {
			@sidebarFolder(folder, i, data.Feeds, data.Counts, data.View)
		}
	</section>
	<section>
		<h5><span>[ system ]</span></h5>
		<a
			class={ "nav-item", templ.KV("active", data.View.Kind == "view" && data.View.ID == "manage") }
			hx-get="/manage"
			hx-target="#main"
			hx-swap="outerHTML"
			hx-push-url="/manage"
		>
			<span class="g">✦</span>
			<span>manage feeds</span>
			<span class="c">{ fmt.Sprint(len(data.Feeds)) }</span>
		</a>
		<a
			class={ "nav-item", templ.KV("active", data.View.Kind == "view" && data.View.ID == "settings") }
			hx-get="/settings"
			hx-target="#main"
			hx-swap="outerHTML"
			hx-push-url="/settings"
		>
			<span class="g">✦</span>
			<span>settings</span>
		</a>
	</section>
}

templ sidebarView(num, label, id string, count int, view ViewState) {
	<a
		class={ "nav-item", templ.KV("active", view.Kind == "view" && view.ID == id) }
		hx-get={ "/views/" + id }
		hx-target="#main"
		hx-swap="outerHTML"
		hx-push-url={ "/v/" + id }
	>
		<span class="g">{ num }</span>
		<span>{ label }</span>
		<span class="c">{ fmt.Sprint(count) }</span>
	</a>
}

templ sidebarFolder(folder store.Folder, idx int, feeds []store.Feed, counts store.Counts, view ViewState) {
	<div class="folder">
		<a
			class={ "nav-item", templ.KV("active", view.Kind == "folder" && view.ID == folder.ID) }
			hx-get={ "/folders/" + folder.ID }
			hx-target="#main"
			hx-swap="outerHTML"
			hx-push-url={ "/folders/" + folder.ID }
		>
			<span class="g">{ Pad2(idx + 1) }</span>
			<span>{ folder.Label }</span>
			<span class="c">{ fmt.Sprint(folderUnread(folder.ID, feeds, counts)) }</span>
		</a>
		<div class="feeds">
			for _, feed := range feeds {
				if feed.Folder == folder.ID {
					@sidebarFeed(feed, counts, view)
				}
			}
		</div>
	</div>
}

func folderUnread(folderID string, feeds []store.Feed, counts store.Counts) int {
	total := 0
	for _, f := range feeds {
		if f.Folder == folderID {
			total += counts.PerFeed[f.ID]
		}
	}
	return total
}

templ sidebarFeed(feed store.Feed, counts store.Counts, view ViewState) {
	<a
		class={ "feed-item", templ.KV("active", view.Kind == "feed" && view.ID == feed.ID), templ.KV("unread", counts.PerFeed[feed.ID] > 0) }
		hx-get={ "/feeds/" + feed.ID }
		hx-target="#main"
		hx-swap="outerHTML"
		hx-push-url={ "/feeds/" + feed.ID }
	>
		<span class="t">{ feed.Title }</span>
		if counts.PerFeed[feed.ID] > 0 {
			<span class="c">{ fmt.Sprint(counts.PerFeed[feed.ID]) }</span>
		} else {
			<span class="c">-</span>
		}
	</a>
}
