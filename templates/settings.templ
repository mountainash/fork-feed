package templates

templ Settings(data SettingsData) {
	<main class="settings-page" id="main">
		<section class="reader">
			<div class="reader-inner">
				<div class="rmeta">
					<span>[ settings ]</span>
					<span class="sep">·</span>
					<span>live</span>
					<span class="sep">·</span>
					<span>{ data.DatabaseDriver }</span>
				</div>
				<h1>settings.</h1>
				<div class="byline">no account. no sync. your reading data lives in your { data.DatabaseDriver } database.</div>
				<div class="settings-grid">
					<div class="s-cell disabled">
						<div class="k">[ reading / mark-read-on ]</div>
						<div class="v">when items become read</div>
						<div class="opts">
							<button class={ templ.KV("on", data.MarkReadOn == "scroll") }>scroll</button>
							<button class={ templ.KV("on", data.MarkReadOn == "open") }>open</button>
							<button class={ templ.KV("on", data.MarkReadOn == "manual") }>manual</button>
						</div>
					</div>
					<div class="s-cell disabled">
						<div class="k">[ refresh / cadence ]</div>
						<div class="v">how often to fetch</div>
						<div class="opts">
							<button class={ templ.KV("on", data.RefreshInterval == "5m0s") }>5m</button>
							<button class={ templ.KV("on", data.RefreshInterval == "15m0s") }>15m</button>
							<button class={ templ.KV("on", data.RefreshInterval == "1h0m0s") }>1h</button>
						</div>
					</div>
					<div class="s-cell disabled">
						<div class="k">[ retention / history ]</div>
						<div class="v">keep read items for</div>
						<div class="opts">
							<button class={ templ.KV("on", data.Retention == "7d") }>7d</button>
							<button class={ templ.KV("on", data.Retention == "30d") }>30d</button>
							<button class={ templ.KV("on", data.Retention == "90d") }>90d</button>
							<button class={ templ.KV("on", data.Retention == "forever") }>forever</button>
						</div>
					</div>
					<div class="s-cell disabled">
						<div class="k">[ display / density ]</div>
						<div class="v">list row height</div>
						<div class="opts">
							<button class={ templ.KV("on", data.Density == "tight") }>tight</button>
							<button class={ templ.KV("on", data.Density == "default") }>default</button>
							<button class={ templ.KV("on", data.Density == "loose") }>loose</button>
						</div>
					</div>
					<div class="s-cell">
						<div class="k">[ display / theme ]</div>
						<div class="v">colour scheme</div>
						<div class="opts" id="theme-opts">
							<button onclick="setTheme('light')" id="theme-light">light</button>
							<button onclick="setTheme('dark')" id="theme-dark">dark</button>
						</div>
						<script>
							(function() {
								var t = localStorage.getItem('theme') || 'light';
								var el = document.getElementById('theme-' + t);
								if (el) el.classList.add('on');
							})();
						</script>
					</div>
				</div>
				<h2 style="font-family:var(--grot);font-size:22px;font-weight:600;letter-spacing:-0.02em;margin-top:48px;margin-bottom:14px">server</h2>
				<div class="server-info">
					<div class="srow"><span class="k">binary</span><span>kontrolplane-feed · go</span></div>
					<div class="srow"><span class="k">router</span><span>net/http.ServeMux</span></div>
					<div class="srow"><span class="k">templ</span><span>a-h/templ</span></div>
					<div class="srow"><span class="k">parser</span><span>mmcdole/gofeed</span></div>
					<div class="srow"><span class="k">db</span><span>{ data.DatabaseDriver } · { data.DatabaseInfo }</span></div>
					<div class="srow"><span class="k">refresh</span><span>{ data.RefreshInterval }</span></div>
				</div>
				<h2 style="font-family:var(--grot);font-size:22px;font-weight:600;letter-spacing:-0.02em;margin-top:48px;margin-bottom:14px">keyboard</h2>
				<div style="display:grid;grid-template-columns:100px 1fr;row-gap:10px;column-gap:18px;font-family:var(--mono);font-size:12px;padding-top:16px;border-top:1px solid var(--rule-strong)">
					<div><span class="inline-kbd">j / k</span></div><div style="opacity:0.85">next / previous item</div>
					<div><span class="inline-kbd">o or ↵</span></div><div style="opacity:0.85">open item in reader</div>
					<div><span class="inline-kbd">s</span></div><div style="opacity:0.85">toggle star</div>
					<div><span class="inline-kbd">m</span></div><div style="opacity:0.85">toggle read / unread</div>
					<div><span class="inline-kbd">/</span></div><div style="opacity:0.85">focus search</div>
					<div><span class="inline-kbd">n</span></div><div style="opacity:0.85">add new feed</div>
				</div>
				<h2 style="font-family:var(--grot);font-size:22px;font-weight:600;letter-spacing:-0.02em;margin-top:48px;margin-bottom:14px">import / export</h2>
				<div style="display:flex;gap:10px;flex-wrap:wrap;padding-top:16px;border-top:1px solid var(--rule-strong)">
					<label class="settings-btn">
						import opml
						<input
							type="file"
							name="file"
							accept=".opml,.xml"
							style="display:none"
							hx-post="/import/opml"
							hx-encoding="multipart/form-data"
							hx-trigger="change"
							hx-swap="none"
						/>
					</label>
					<a class="settings-btn" href="/export/opml" download="feeds.opml">export opml</a>
				</div>
			</div>
		</section>
	</main>
	<section id="reader" hx-swap-oob="outerHTML" style="display:none"></section>
}
