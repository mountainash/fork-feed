package templates

templ Layout() {
	<!doctype html>
	<html lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width,initial-scale=1"/>
		<title>kontrolplane/feed - rss, without the noise</title>
		<link rel="stylesheet" href="/static/css/styles.css"/>
		<script>
			(function(){var t=localStorage.getItem('theme');if(t==='dark')document.documentElement.setAttribute('data-theme','dark');})();
			function setTheme(t){localStorage.setItem('theme',t);if(t==='dark'){document.documentElement.setAttribute('data-theme','dark')}else{document.documentElement.removeAttribute('data-theme')}document.querySelectorAll('#theme-opts button').forEach(function(b){b.classList.remove('on')});var el=document.getElementById('theme-'+t);if(el)el.classList.add('on');}
		</script>
	</head>
	<body>
		<div class="app">
			<header class="topbar">
				<div class="brand">
					<span class="stagger"><i></i><i></i><i></i></span>
					kontrolplane/feed
				</div>
				<div class="search">
					<span class="prompt">/</span>
					<input
						type="search"
						name="q"
						placeholder="search items, authors, abstracts…"
						hx-get="/search"
						hx-trigger="keyup changed delay:200ms, search"
						hx-target="#main"
						hx-swap="outerHTML"
						hx-indicator="#sync-indicator"
					/>
					<kbd>/</kbd>
				</div>
				<div class="tools">
					<button
						class="btn"
						hx-get="/feeds/new"
						hx-target="#modal"
						hx-swap="innerHTML"
					>＋ add feed</button>
					<button
						class="btn"
						hx-get="/partials/list"
						hx-target="#main"
						hx-swap="outerHTML"
						hx-indicator="#sync-indicator"
					>
						<span class="dot"></span>
						sync · now
					</button>
				</div>
			</header>
			{ children... }
		</div>
		<div id="modal"></div>
		<script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js" crossorigin="anonymous"></script>
		<script src="/static/js/hotkeys.js"></script>
	</body>
	</html>
}
