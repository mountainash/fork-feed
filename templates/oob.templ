package templates

templ OOBSidebar(data SidebarData) {
	<aside class="sidebar" id="sidebar" hx-swap-oob="outerHTML">
		@sidebarInner(data)
	</aside>
}

templ OOBReaderReset() {
	<section class="reader" id="reader" hx-swap-oob="outerHTML">
		@readerEmpty()
	</section>
}

templ OOBStatus(data StatusData) {
	<footer
		class="status"
		id="status"
		hx-swap-oob="outerHTML"
		hx-get="/partials/status"
		hx-trigger="every 900s"
	>
		@statusInner(data)
	</footer>
}
