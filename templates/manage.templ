package templates

import "github.com/kontrolplane/feed/internal/store"
import "fmt"

templ Manage(data ManageData) {
	<main class="manage-page" id="main">
		<section class="reader">
			<div class="reader-inner">
				<div class="rmeta">
					<span>[ system / manage ]</span>
					<span class="sep">·</span>
					<span>{ fmt.Sprintf("%d feeds", len(data.Feeds)) }</span>
				</div>
				<h1>manage feeds.</h1>
				<div class="byline">add, rename, or remove your subscriptions.</div>
				<div class="manage-actions">
					<button
						class="manage-add"
						hx-get="/feeds/new"
						hx-target="#modal"
						hx-swap="innerHTML"
					>＋ add feed</button>
				</div>
				for _, folder := range data.Folders {
					@manageFolder(folder, data.Feeds)
				}
			</div>
		</section>
	</main>
	<section id="reader" hx-swap-oob="outerHTML" style="display:none"></section>
}

templ manageFolder(folder store.Folder, feeds []store.Feed) {
	<div class="manage-folder">
		<div class="manage-folder-head">[ { folder.Label } ]</div>
		<div class="manage-grid">
			for _, feed := range feeds {
				if feed.Folder == folder.ID {
					@manageFeedCard(feed, folder)
				}
			}
		</div>
	</div>
}

templ manageFeedCard(feed store.Feed, folder store.Folder) {
	<div class="manage-card" id={ "manage-feed-" + feed.ID }>
		<div class="manage-card-body">
			<div class="manage-card-title">{ feed.Title }</div>
			<div class="manage-card-url">{ TruncateURL(feed.URL) }</div>
			<div class="manage-card-meta">
				<span>{ folder.Label }</span>
			</div>
		</div>
		<div class="manage-card-footer">
			<button
				class="manage-btn"
				hx-get={ "/feeds/" + feed.ID + "/edit" }
				hx-target={ "#manage-feed-" + feed.ID }
				hx-swap="outerHTML"
			>edit</button>
			<button
				class="manage-btn danger"
				hx-get={ "/feeds/" + feed.ID + "/confirm-delete" }
				hx-target={ "#manage-feed-" + feed.ID }
				hx-swap="outerHTML"
			>unsubscribe</button>
		</div>
	</div>
}

templ ManageFeedConfirmDelete(feed store.Feed) {
	<div class="manage-card confirming" id={ "manage-feed-" + feed.ID }>
		<div class="manage-card-body">
			<div class="manage-card-warn">unsubscribe?</div>
			<div class="manage-card-warn-sub">
				remove <strong>{ feed.Title }</strong> and all its items. this cannot be undone.
			</div>
		</div>
		<div class="manage-card-footer">
			<button
				class="manage-btn"
				hx-get="/manage"
				hx-target="#main"
				hx-swap="outerHTML"
			>cancel</button>
			<button
				class="manage-btn danger-fill"
				hx-delete={ "/feeds/" + feed.ID }
				hx-target="#main"
				hx-swap="outerHTML"
			>unsubscribe →</button>
		</div>
	</div>
}

templ ManageFeedEdit(feed store.Feed, folders []store.Folder) {
	<div class="manage-card editing" id={ "manage-feed-" + feed.ID }>
		<form
			hx-put={ "/feeds/" + feed.ID }
			hx-target="#main"
			hx-swap="outerHTML"
		>
			<div class="manage-card-body">
				<label>name</label>
				<input type="text" name="title" value={ feed.Title }/>
				<label>url</label>
				<input type="url" name="url" value={ feed.URL }/>
				<label>folder</label>
				@FolderPicker(folders, feed.Folder)
			</div>
			<div class="manage-card-footer">
				<button
					type="button"
					class="manage-btn"
					hx-get="/manage"
					hx-target="#main"
					hx-swap="outerHTML"
				>cancel</button>
				<button type="submit" class="manage-btn primary">save</button>
			</div>
		</form>
	</div>
}
