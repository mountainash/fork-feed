{
  "name": "kontrolplane-feed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted RSS reader — Bun + HTMX + SQLite as a single-file executable.",
  "scripts": {
    "dev": "bun --hot ./src/server.ts",
    "start": "bun ./src/server.ts",
    "build": "bun build --compile --minify ./src/server.ts --outfile ./dist/kontrolplane-feed",
    "build:linux-x64": "bun build --compile --minify --target=bun-linux-x64 ./src/server.ts --outfile ./dist/kontrolplane-feed-linux-x64",
    "clean": "rm -rf dist feed.db feed.db-shm feed.db-wal tmp"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1"
  }
}
